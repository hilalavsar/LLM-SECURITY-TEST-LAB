# === LLM Security Test Lab — Ornek ortam degiskenleri ===
# Bu dosyayi ".env" olarak kopyala ve degerleri doldur.
# .env ASLA git'e commit edilmez (.gitignore icinde).

# --- Veritabani (PostgreSQL / Docker) ---
DATABASE_URL=postgresql+psycopg2://labuser:labpass@localhost:5432/llmseclab
POSTGRES_USER=labuser
POSTGRES_PASSWORD=labpass
POSTGRES_DB=llmseclab

# --- Ollama (L1 Model Runtime) ---
OLLAMA_HOST=http://localhost:11434

# --- Hedef modeller (test edilecek) ---
TARGET_MODEL_PRIMARY=qwen2.5:7b
TARGET_MODEL_SECONDARY=llama3.1:8b-instruct-q4_K_M

# --- Reproduksiyon icin varsayilan uretim ayarlari ---
# Bu ayarlar her test_run kaydinda snapshot'lanir.
GEN_TEMPERATURE=0.0
GEN_SEED=42
GEN_TOP_P=1.0
GEN_NUM_PREDICT=256

# --- Judge (L3 evaluator ikinci katman) ---
# Baslangicta bos; judge modeli sectikce doldurulacak.
JUDGE_MODEL=
JUDGE_MODE=rules_only
