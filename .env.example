# === LLM Security Test Lab — Example environment variables ===
# Copy this file to ".env" and adjust values.
# .env is gitignored — NEVER commit it.

# --- Database (PostgreSQL / Docker) ---
DATABASE_URL=postgresql+psycopg2://labuser:labpass@localhost:5432/llmseclab
POSTGRES_USER=labuser
POSTGRES_PASSWORD=labpass
POSTGRES_DB=llmseclab

# --- Ollama (L1 model runtime) ---
OLLAMA_HOST=http://localhost:11434

# --- Google Gemini (optional target model) ---
# Get a key from https://aistudio.google.com/  (or Google Cloud Vertex AI).
# Leave EMPTY to disable Gemini — it just won't appear in the target dropdown.
GEMINI_API_KEY=
