# LLM Security Test Lab — örnek ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayıp düzenleyin.
# .env git'e girmez; gerçek anahtarları ASLA bu dosyaya yazmayın.

# --- PostgreSQL (docker compose) ---
# localhost yerine 127.0.0.1: Windows'ta IPv6 (::1) bağlantısı reddedilebiliyor.
DATABASE_URL=postgresql+psycopg2://labuser:labpass@127.0.0.1:5432/llmseclab
POSTGRES_USER=labuser
POSTGRES_PASSWORD=labpass
POSTGRES_DB=llmseclab

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434

# --- Google Gemini (isteğe bağlı) ---
# Anahtar: https://aistudio.google.com/  Boş bırakılırsa Gemini listede çıkmaz.
# Anahtarı Sağlayıcılar sayfasından da girebilirsiniz (sadece bellekte tutulur).
GEMINI_API_KEY=

# --- Arayüzden yazma izinleri ---
# Sağlayıcı ekleme, dataset yükleme ve savunma düzenleme. Paylaşılan sunucuda false yapın.
ALLOW_UI_PROVIDERS=true
